{
  "gates": [
    {
      "name": "lint",
      "command": "uv run --extra dev ruff check .",
      "required": true
    },
    {
      "name": "test",
      "command": "uv run --extra dev pytest",
      "required": true
    },
    {
      "name": "audit",
      "command": "uv run --group dev pip-audit --ignore-vuln CVE-2026-45829",
      "required": false
    }
  ]
}
